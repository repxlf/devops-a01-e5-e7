{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rejected job creation response",
  "type": "object",
  "additionalProperties": false,
  "required": ["http_status", "error", "provenance"],
  "properties": {
    "http_status": {"const": 400},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"const": "REQUEST_REJECTED"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {"enum": ["MOCK_FIXTURE", "CONTRACT_EXAMPLE", "REAL_TOOL_OUTPUT"]}
  }
}
