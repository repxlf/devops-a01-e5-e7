{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.nju.edu.cn/devops-a01/devops-a01/devops-a01/-/raw/main/schemas/dependency-graph.schema.json",
  "title": "DevOps A01 dependency graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_id", "graph_kind", "commit", "configuration_id", "nodes", "edges"],
  "properties": {
    "provenance": {"enum": ["MOCK_FIXTURE", "CONTRACT_EXAMPLE", "REAL_TOOL_OUTPUT"]},
    "graph_id": {"type": "string"},
    "base_graph_id": {
      "type": "string",
      "minLength": 1,
      "description": "本图所基于的基线图 graph_id；仅增量检测产出的图需要填写。"
    },
    "graph_kind": {"enum": ["ACTUAL", "DECLARED"]},
    "commit": {"type": "string"},
    "configuration_id": {"type": "string"},
    "nodes": {"type": "array", "items": {"type": "string"}},
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string", "description": "依赖边的起点：构建目标。"},
          "target": {"type": "string", "description": "依赖边的终点：目标所依赖的文件。"},
          "evidence": {"type": "string"}
        }
      }
    }
  }
}
